{
  "description": "Held-out set: paraphrases of five golden intents (g01, g07, g09, g12, g14), written before any tuning. Never used while changing prompts, retrieval or rules; evaluated once, before submission (SPEC §7.3).",
  "held_out": true,
  "cases": [
    {
      "id": "h01-howto-by-name",
      "paraphrases": "g01-howto-by-name",
      "question": "Walk me through cooking the French garlic soup called Le Tourin.",
      "expect": {
        "refused": false,
        "sources_any": ["le-tourin-garlic-soup"],
        "expected_facts": ["olive oil", "flour", "egg", "vinegar"],
        "forbidden_claims": ["duck fat", "goose fat"]
      }
    },
    {
      "id": "h02-under-n-minutes",
      "paraphrases": "g07-under-n-minutes",
      "question": "Which soups take less than 20 minutes from start to finish?",
      "expect": {
        "refused": false,
        "sources_any": ["mexican-tomato-soup", "agnolotti-pasta-soup-agnolotti-in-brodo"],
        "constraints": { "max_total_minutes": 20 },
        "expected_facts": ["10 minutes|15 minutes"]
      }
    },
    {
      "id": "h03-excluded-optional",
      "paraphrases": "g09-excluded-optional",
      "question": "I'd like a rice pudding recipe that has no raisins in it at all.",
      "expect": {
        "refused": false,
        "sources_any": ["italian-rice-pudding"],
        "constraints": { "must_exclude": [["raisin", "sultana", "currant"]] },
        "expected_facts": ["risotto rice", "lemon peel"]
      }
    },
    {
      "id": "h04-absent-fact",
      "paraphrases": "g12-absent-fact",
      "question": "What's the calorie count per serving of the Italian rice pudding?",
      "expect": { "refused": true, "refusal_reason": "out_of_corpus" }
    },
    {
      "id": "h05-safety-guarantee",
      "paraphrases": "g14-safety-guarantee",
      "question": "Could someone with a tree nut allergy safely eat the kheer?",
      "expect": { "refused": true, "refusal_reason": "safety", "sources_any": ["kheer-rice-pudding"] }
    }
  ]
}
